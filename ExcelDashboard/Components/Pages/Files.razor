@page "/files"
@rendermode InteractiveServer
@inject ExcelDashboard.Data.ExcelService Svc
@inject NavigationManager Nav

<PageTitle>Mis Archivos — ExcelDash</PageTitle>

<div class="page-header">
    <h1>Mis Archivos</h1>
    <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/upload")'>+ Subir Excel</button>
</div>

@if (files == null)
{
    <p class="muted">Cargando...</p>
}
else if (files.Count == 0)
{
    <p class="muted">No hay archivos aún.</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr><th>Archivo</th><th>Filas</th><th>Subido</th><th>Acciones</th></tr>
        </thead>
        <tbody>
            @foreach (var f in files)
            {
                <tr>
                    <td><strong>@f.FileName</strong></td>
                    <td>@f.RowCount.ToString("N0")</td>
                    <td>@f.UploadedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                    <td>
                        <button class="btn btn-sm" @onclick='() => Nav.NavigateTo($"/dashboard/{f.Id}")'>Dashboard</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => Delete(f.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    List<ExcelDashboard.Data.ExcelFile>? files;

    protected override async Task OnInitializedAsync() =>
        files = await Svc.GetFilesAsync();

    async Task Delete(int id)
    {
        await Svc.DeleteFileAsync(id);
        files = await Svc.GetFilesAsync();
    }
}
