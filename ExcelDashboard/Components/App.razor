<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Excel Dashboard</title>
    <link rel="stylesheet" href="css/app.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.server.js"></script>
    <script>
        window.renderChart = (canvasId, type, labels, values, label) => {
            const canvas = document.getElementById(canvasId);
            if (!canvas) return;
            if (canvas._chartInstance) canvas._chartInstance.destroy();
            const colors = labels.map((_, i) => `hsl(${(i * 47) % 360},65%,55%)`);
            canvas._chartInstance = new Chart(canvas, {
                type: type,
                data: {
                    labels,
                    datasets: [{
                        label,
                        data: values,
                        backgroundColor: type === 'line' ? 'rgba(59,130,246,0.15)' : colors,
                        borderColor: type === 'line' ? 'rgb(59,130,246)' : colors,
                        borderWidth: type === 'line' ? 2 : 1,
                        fill: type === 'line',
                        tension: 0.3,
                        pointRadius: type === 'line' ? 4 : 0
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: type !== 'bar' } },
                    scales: type !== 'pie' && type !== 'doughnut'
                        ? { y: { beginAtZero: true } } : {}
                }
            });
        };
    </script>
</body>
</html>
